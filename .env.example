# CoreVault Enterprise Workspace OS Configuration
PORT=3000
NODE_ENV=production
DATA_DIR=./data
DATABASE_PATH=./data/corevault.db

# PostgreSQL Connection String (Dokploy internal cluster, Neon, Supabase, RDS, etc.)
# Leave empty to use high-performance embedded SQLite in ./data/corevault.db
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/<dbname>

# Resend.com Email Service (OTP Verification, Passwordless Login & Team Invitations)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_ADDRESS=no-reply@yourdomain.com
RESEND_FROM_NAME="CoreVault Security"

# S3-Compatible Cloud Storage Bucket (Cloudflare R2, MinIO, Wasabi, AWS S3, Supabase)
# Recommended Free Choice: Cloudflare R2 gives 10 GB free storage forever with $0 egress fees!
# Or self-hosted MinIO: http://localhost:9000
S3_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_access_key_id
S3_SECRET-KEY=your_secret_access_key
BUCKET_NAME=corevault-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
